<%layout("layouts/boilerplate")%>
<div class="container">
<div class="scroll-container">
  <div class="scroll-content">
    <div class="category-item">
      <i class="fas fa-globe"></i>
      <span>World</span>
    </div>
    <div class="category-item">
      <i class="fas fa-city"></i>
      <span>Urban</span>
    </div>
    <div class="category-item">
      <i class="fas fa-tree"></i>
      <span>Nature</span>
    </div>
    <div class="category-item">
      <i class="fas fa-water"></i>
      <span>Beach</span>
    </div>
    <div class="category-item">
      <i class="fas fa-mountain"></i>
      <span>Mountain</span>
    </div>
    <div class="category-item">
      <i class="fas fa-star"></i>
      <span>Luxury</span>
    </div>
    <div class="category-item">
      <i class="fas fa-bed"></i>
      <span>Relax</span>
    </div>
   <div class="form-check-reverse form-switch tax-toggle">
      <input class="form-check-input me-1"  type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
    </div>

    
  </div>
  
</div>
  
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col card-listing">
      <img src="<%=listing.image.url%>" class="card-img-top" alt="Listing Image" style="height: 20rem;">
      <div class="card-img-overlay"></div>
      <div class="card-body">  
        <p class="card-text">
          <b><%=listing.title%></b> <br>
          &#8360;<%=listing.price.toLocaleString("en-IN")%> / night
          <i class="tax-info">&nbsp; &nbsp;+18% GST</i>
        </p>
      </div>
    </div>
  </a>
  <% } %>
</div>

</div>